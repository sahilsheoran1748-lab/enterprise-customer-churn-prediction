{
    "project_name": "Enterprise Customer Churn Prediction",
    "project_type": "Supervised Machine Learning",
    "domain": "Telecommunications / Customer Analytics",
    "dataset": {
        "rows": 7043,
        "original_columns": 21,
        "final_features": 21,
        "target_column": "Churn",
        "target_classes": [
            "No",
            "Yes"
        ]
    },
    "data_split": {
        "training_samples": 5634,
        "testing_samples": 1409,
        "test_size": 0.2,
        "random_state": 42,
        "stratified": true
    },
    "feature_engineering": [
        "TotalCharges numeric conversion",
        "Median imputation for missing TotalCharges",
        "AvgMonthlySpend",
        "TotalServicesActive",
        "customerID removal"
    ],
    "models_evaluated": [
        "Logistic Regression",
        "Random Forest",
        "XGBoost",
        "Tuned XGBoost with Optuna"
    ],
    "final_model": {
        "name": "Tuned XGBoost",
        "optimization_method": "Optuna",
        "optimization_trials": 50,
        "cv_folds": 5,
        "objective_metric": "ROC-AUC"
    },
    "final_model_performance": {
        "accuracy": 0.8062,
        "precision": 0.6797,
        "recall": 0.5107,
        "f1_score": 0.5832,
        "roc_auc": 0.8488
    },
    "deployment": {
        "pipeline_file": "models/churn_prediction_pipeline.joblib",
        "prediction_threshold": 0.5,
        "high_risk_threshold": 0.7
    }
}